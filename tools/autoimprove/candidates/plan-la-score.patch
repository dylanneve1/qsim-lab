+            }
+            allowed |= 1 << q;
+        }
+        let mut hi = 0usize;
+        let mut cur: Vec<KOp> = Vec::new();
+        let mut skipped: Vec<KOp> = Vec::new();
+        let (mut sk_nd, mut sk_touch) = (0usize, 0usize);
+        let mut first_skip = None;
+        for (i, op) in rest.iter().enumerate() {
