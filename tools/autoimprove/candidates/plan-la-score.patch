+    // Each stage takes, in order, every remaining op that fits its slots and
+    // commutes with every op it skipped (two ops commute unless one acts
+    // non-diagonally on a qubit the other touches; with the skipped ops'
+    // masks OR-ed together this test is exact and O(1)). Skipped ops keep
+    // their order and form the input of the next stage. The scan stops
+    // `LOOKAHEAD` ops after the first skip, bounding the work per stage.
+    const LOOKAHEAD: usize = 1024;
+    // The stage's outer qubits are chosen up front: those of its first op,
+    // then the highest-scoring ones, where every op in the next
+    // `SCORE_WINDOW` ops adds a weight decaying with its distance to each
+    // high qubit it needs.
+    const SCORE_WINDOW: usize = 512;
