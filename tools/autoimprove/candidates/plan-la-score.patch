+    let mut rest: Vec<KOp> = ops.to_vec();
+    let mut score = vec![0f64; n];
+    while !rest.is_empty() {
+        score.iter_mut().for_each(|x| *x = 0.0);
+        for (i, op) in rest.iter().take(SCORE_WINDOW).enumerate() {
+            let mut need = op.needs_inner() & !low;
+            while need != 0 {
+                score[need.trailing_zeros() as usize] += 1.0 / (1.0 + i as f64 / 32.0);
+                need &= need - 1;
+            }
+        }
+        let mut allowed = rest[0].needs_inner() & !low;
+        let mut order: Vec<usize> = (0..n).filter(|q| score[*q] > 0.0).collect();
+        order.sort_by(|a, b| score[*b].total_cmp(&score[*a]));
+        for q in order {
