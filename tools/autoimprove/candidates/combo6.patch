+/// The pair kernel on one run: `a = [a0r, a0i, a1r, a1i, a2r, a2i, a3r,
+/// a3i]` are the four amplitude slices (index bits `t1`, `t2` = 00, 10,
+/// 01, 11). A separate function taking the slices as `&mut` parameters, so
+/// the compiler knows they do not alias and vectorises the loop (with
+/// eight slices split inside one function it would need 28 run-time alias
+/// checks and falls back to scalar code: 0.45x on brickwork f32).
+#[inline(always)]
+fn pair_kernel<T: Real, const F: bool, const K1: u8, const K2: u8, const CX: u8>(
+    a: [&mut [T]; 8],
+    m1: &[T; 8],
+    m2: &[T; 8],
+) {
+    let [a0r, a0i, a1r, a1i, a2r, a2i, a3r, a3i] = a;
+    pair_loop::<T, F, K1, K2, CX>(a0r, a0i, a1r, a1i, a2r, a2i, a3r, a3i, m1, m2);
+}
+
+#[allow(clippy::too_many_arguments)]
+#[inline(always)]
+fn pair_loop<T: Real, const F: bool, const K1: u8, const K2: u8, const CX: u8>(
+    a0r: &mut [T],
+    a0i: &mut [T],
+    a1r: &mut [T],
+    a1i: &mut [T],
+    a2r: &mut [T],
+    a2i: &mut [T],
+    a3r: &mut [T],
+    a3i: &mut [T],
+    m1: &[T; 8],
+    m2: &[T; 8],
+) {
+    let len = a0r.len();
+    let (a1r, a2r, a3r) = (&mut a1r[..len], &mut a2r[..len], &mut a3r[..len]);
+    let (a0i, a1i, a2i, a3i) = (
+        &mut a0i[..len],
+        &mut a1i[..len],
+        &mut a2i[..len],
+        &mut a3i[..len],
+    );
+    for k in 0..len {
+        let (b0r, b0i, b1r, b1i) = mat_apply::<T, F, K1>(m1, a0r[k], a0i[k], a1r[k], a1i[k]);
+        let (b2r, b2i, b3r, b3i) = mat_apply::<T, F, K1>(m1, a2r[k], a2i[k], a3r[k], a3i[k]);
+        let (c0r, c0i, c2r, c2i) = mat_apply::<T, F, K2>(m2, b0r, b0i, b2r, b2i);
+        let (c1r, c1i, c3r, c3i) = mat_apply::<T, F, K2>(m2, b1r, b1i, b3r, b3i);
+        // the CNOT permutes the pair of amplitudes whose control bit is 1
+        let ((c1r, c1i, c3r, c3i), (c2r, c2i)) = match CX {
+            1 => ((c3r, c3i, c1r, c1i), (c2r, c2i)),
+            _ => ((c1r, c1i, c3r, c3i), (c2r, c2i)),
+        };
+        let ((c2r, c2i, c3r, c3i), (c1r, c1i)) = match CX {
+            2 => ((c3r, c3i, c2r, c2i), (c1r, c1i)),
+            _ => ((c2r, c2i, c3r, c3i), (c1r, c1i)),
+        };
+        a0r[k] = c0r;
+        a0i[k] = c0i;
+        a1r[k] = c1r;
+        a1i[k] = c1i;
+        a2r[k] = c2r;
+        a2i[k] = c2i;
+        a3r[k] = c3r;
+        a3i[k] = c3i;
+    }
+}
+
+/// `m1` on bit `t1` and `m2` on bit `t2` (`t1 < t2`, both `>= 2`), then
+/// for `CX = 1` a CNOT `t1 -> t2` and for `CX = 2` a CNOT `t2 -> t1`, in
+/// one sweep: each group of four amplitudes is loaded once, the gates are
+/// applied in registers, and it is stored once.
+#[inline(always)]
+fn apply_pair<T: Real, const F: bool, const K1: u8, const K2: u8, const CX: u8>(
+    buf: &mut View<T>,
+    t1: usize,
+    m1: &[T; 8],
+    t2: usize,
+    m2: &[T; 8],
+) {
+    let (s1, s2) = (1usize << t1, 1usize << t2);
+    let View { re, im } = buf;
+    for (cr, ci) in re.chunks_exact_mut(2 * s2).zip(im.chunks_exact_mut(2 * s2)) {
+        let (lr, hr) = cr.split_at_mut(s2);
+        let (li, hi) = ci.split_at_mut(s2);
+        for (((lr, hr), li), hi) in lr
+            .chunks_exact_mut(2 * s1)
+            .zip(hr.chunks_exact_mut(2 * s1))
+            .zip(li.chunks_exact_mut(2 * s1))
+            .zip(hi.chunks_exact_mut(2 * s1))
+        {
+            let (a0r, a1r) = lr.split_at_mut(s1);
+            let (a2r, a3r) = hr.split_at_mut(s1);
+            let (a0i, a1i) = li.split_at_mut(s1);
+            let (a2i, a3i) = hi.split_at_mut(s1);
+            pair_kernel::<T, F, K1, K2, CX>([a0r, a0i, a1r, a1i, a2r, a2i, a3r, a3i], m1, m2);
+        }
+    }
+}
