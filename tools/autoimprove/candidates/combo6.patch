+/// `(x, y) <- (m0 x + m1 y, m2 x + m3 y)`; `K = 1`: real matrix (an X
+/// is the real matrix `[0 1; 1 0]`, exact), `K = 2`: complex.
+#[inline(always)]
+fn mat_apply<T: Real, const F: bool, const K: u8>(
+    m: &[T; 8],
+    xr: T,
+    xi: T,
+    yr: T,
+    yi: T,
+) -> (T, T, T, T) {
+    let [m0r, m1r, m2r, m3r, m0i, m1i, m2i, m3i] = *m;
+    if K == 1 {
+        (
+            fma::<T, F>(m0r, xr, m1r * yr),
+            fma::<T, F>(m0r, xi, m1r * yi),
+            fma::<T, F>(m2r, xr, m3r * yr),
+            fma::<T, F>(m2r, xi, m3r * yi),
+        )
+    } else {
+        let (a, b) = cmul2::<T, F>([m0r, m0i, m1r, m1i], xr, xi, yr, yi);
+        let (c, d) = cmul2::<T, F>([m2r, m2i, m3r, m3i], xr, xi, yr, yi);
+        (a, b, c, d)
+    }
+}
