# hand-written: every instruction of the subset, aliases, nested REPEAT,
# observables between detectors, repeated records, tags and coordinates
QUBIT_COORDS(0, 0) 0
RX 0
R 1 2 3
X_ERROR(0.01) 1 2
Z_ERROR(0.02) 0
TICK
H 1
S 2
S_DAG 3
SQRT_Z 1
H_XZ 3
CX 0 1 2 3
CNOT 1 2
ZCX 3 0
CZ 0 2
ZCZ 1 3
SWAP 0 3
DEPOLARIZE1(0.003) 0 1 2 3
DEPOLARIZE2(0.004) 0 1 2 3
Y_ERROR(0.005) 2
MX(0.01) 0
MR(0.01) 1
DETECTOR(0, 0, 0) rec[-2]
REPEAT 3 {
    CX 2 1
    DEPOLARIZE2(0.002) 2 1
    H 3
    CZ 3 0
    REPEAT 2 {
        MRX(0.01) 3
        MRZ(0.01) 1
        DETECTOR rec[-1] rec[-3] rec[-3] rec[-1] rec[-1]
        X_ERROR[tag](0.001) 3
    }
    OBSERVABLE_INCLUDE(1) rec[-2]
    MZ(0.01) 2
    SHIFT_COORDS(0, 0, 1)
    DETECTOR(1, 2, 3) rec[-1] rec[-2]
    I 0
    X 0
    Y 1
    Z 2
}
M(0.01) 0 1 2 3
DETECTOR rec[-4] rec[-5]
OBSERVABLE_INCLUDE(0) rec[-1] rec[-2]
DETECTOR rec[-3]
