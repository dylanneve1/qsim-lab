##### scripts
#!/bin/bash
Q=~/qsim-shor-r4-target/release/qsim
until mkdir /tmp/qsim-mac-bench.lock 2>/dev/null; do sleep 5; done
echo "lock acquired $(date) load $(sysctl -n vm.loadavg)"
for rep in 1 2; do for L in 8 16 32; do
 echo "rep=$rep L=$L $(QSIM_SLICE_PROFILE=1 QSIM_SLICE_LANES=$L $Q run shor --modulus 4297567 --semiclassical --oracle windowed --sliced --base 3 --seed 1 2>&1 | grep -o 'time [0-9.]*\|eval c=1 [0-9.]*s\|sort [0-9.]*s\|collapse [0-9.]*s' | tr '\n' ' ')"
done; done
for N in 10161323 18942389; do
echo "== $N generic, random base, seed 1 (load $(sysctl -n vm.loadavg))"
QSIM_SLICE_PROFILE=1 /usr/bin/time -l $Q run shor --modulus $N --semiclassical --oracle windowed --sliced --seed 1 --tries 5 2>&1 | grep -v "^note" | grep -E "profile|a=|=|time |maximum resident"
done
rmdir /tmp/qsim-mac-bench.lock
echo done $(date)
#!/bin/bash
Q=~/qsim-shor-r4-target/release/qsim
run() { echo "== $* (load $(sysctl -n vm.loadavg))"; QSIM_SLICE_PROFILE=1 /usr/bin/time -l $Q run shor --semiclassical --oracle windowed --window 4 --sliced "$@" 2>&1 | grep -v "^note" | grep -E "profile|a=|=|time |maximum resident"; }
until mkdir /tmp/qsim-mac-bench.lock 2>/dev/null; do sleep 3; done
echo "lock (build) $(date)"
cd ~/qsim-shor-r4 && git fetch -q origin exp/shor-r4 && git checkout -q --detach FETCH_HEAD && git log --oneline -1
CARGO_TARGET_DIR=~/qsim-shor-r4-target /opt/homebrew/bin/cargo build --release --bin qsim 2>&1 | tail -1
rmdir /tmp/qsim-mac-bench.lock
sleep 2
until mkdir /tmp/qsim-mac-bench.lock 2>/dev/null; do sleep 3; done
echo "lock B1 $(date)"
run --modulus 82337219 --seed 1 --tries 3
run --modulus 43584217 --seed 2 --tries 3
rmdir /tmp/qsim-mac-bench.lock
sleep 2
until mkdir /tmp/qsim-mac-bench.lock 2>/dev/null; do sleep 3; done
echo "lock B2 $(date)"
run --modulus 8795579227471 --seed 1 --tries 2
rmdir /tmp/qsim-mac-bench.lock
echo done $(date)
